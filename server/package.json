{
  "name": "eventhive-server",
  "version": "1.0.0",
  "description": "EventHive Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "MONGODB_URI=mongodb://localhost:27017/eventhive_test JWT_SECRET=test-secret node --import tsx --test src/tests/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  }
}
